{
  "resource": {
    "signoz_auth_domain": {
      "scenario_03": {
        "name": "google.scenario-03.example.com",
        "enabled": false,
        "config": {
          "google": {
            "kind": "google",
            "spec": {
              "client_id": "912345678901-scenario03.apps.googleusercontent.com",
              "client_secret": "GOCSPX-scenario-03-secret",
              "allowed_groups": ["engineering@example.com"],
              "insecure_skip_email_verified": false
            }
          }
        },
        "role_mapping": {
          "default_role": "VIEWER",
          "use_role_attribute": false,
          "group_mappings": {
            "engineering@example.com": "EDITOR"
          }
        }
      }
    }
  }
}
